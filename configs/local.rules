alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"SSH Brute Force Attack"; flow:established,to_server; content:"SSH-"; $
alert udp any any -> any any (msg:"UDP Flood DoS Detected"; dsize:>1000; threshold:type threshold,track by_src, count 1$
alert tcp $HOME_NET any -> $HOME_NET $HTTP_PORTS (msg:"Dectected SQL Injection Attack ."; flow:established,to_server; c$

