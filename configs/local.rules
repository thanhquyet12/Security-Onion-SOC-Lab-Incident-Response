# ---------------------------------------------------------
# CUSTOM SURICATA RULES - SOC LAB BY QUYETNT
# ---------------------------------------------------------

# 1. SSH BRUTE FORCE
# Phát hiện 5 nỗ lực kết nối mới tới cổng 22 trong vòng 60 giây
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt Detected"; flags:S; threshold:type both, track by_src, count 5, seconds 60; sid:1000006; rev:1;)

# 2. DOS/DDOS (UDP FLOOD)
# Phát hiện gói tin UDP > 1000 bytes với tần suất > 100 gói/giây
alert udp any any -> $HOME_NET any (msg:"UDP Flood Attack Detected"; dsize:>1000; threshold:type threshold, track by_src, count 100, seconds 1; sid:1000007; rev:1;)

# 3. SQL INJECTION (Web Attacks)
alert tcp any any -> $HOME_NET 80 (msg:"SQLi Attempt - Logic Bypass (' or 1=1)"; content:"' or 1=1"; nocase; http_uri; sid:1000008; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"SQLi Attempt - UNION SELECT"; content:"union select"; nocase; http_uri; sid:1000009; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"SQLi Attempt - Comment Dash"; content:"--"; http_uri; sid:1000010; rev:1;)

# 4. TRUY CẬP FILE NHẠY CẢM
alert tcp any any -> $HOME_NET 80 (msg:"Access to /etc/passwd Attempt"; content:"/etc/passwd"; nocase; sid:1000004; rev:1;)

# 5. CÁC KIỂU QUÉT MẠNG & ICMP FLOOD
alert icmp any any -> $HOME_NET any (msg:"ICMP Flood Detected"; itype:8; threshold:type threshold, track by_src, count 100, seconds 1; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Nmap XMAS Scan Detected"; flags:FPU; sid:1000002; rev:1;)

# 6. PHÁT HIỆN REVERSE SHELL TIỀM ẨN
alert tcp $HOME_NET any -> any any (msg:"Potential Reverse Shell Connection (NC)"; content:"nc "; nocase; sid:1000003; rev:1;)
